menu "ELE Crypto"

  config MCUX_COMPONENT_component.ele_crypto
      bool "ele_crypto"
      select MCUX_COMPONENT_driver.s3mu

      if MCUX_COMPONENT_component.ele_crypto
        # ELE firmware variant: S400 (RT1180) or S100 (RT2660)
        choice MCUX_DEPENDENCY_COMPONENT_component.ele_crypto.variant
          prompt "ELE firmware variant"
          default MCUX_COMPONENT_component.ele_crypto_s400 if MCUX_HW_IP_DriverType_EDGELOCK
          default MCUX_COMPONENT_component.ele_crypto_s100 if MCUX_HW_IP_DriverType_S3MU

          config MCUX_COMPONENT_component.ele_crypto_s400
              bool "ELE S400 (RT1180, ELE400/ELE401)"
              depends on MCUX_HW_IP_DriverType_EDGELOCK
              help
                Use the S400 ELE firmware backend (ele_crypto.c).  This is the
                variant present on i.MX RT1180 with the ELE400 or ELE401 IP.

          config MCUX_COMPONENT_component.ele_crypto_s100
              bool "ELE S100 (RT2660)"
              depends on MCUX_HW_IP_DriverType_S3MU
              help
                Use the S100 ELE firmware backend (ele_crypto_s100.c).  This is
                the variant present on i.MX RT2660.

        endchoice

        choice MCUX_DEPENDENCY_COMPONENT_component.ele_crypto.cache_driver
          prompt "ele_crypto cache dependency"
          default MCUX_DEPENDENCY_COMPONENT_component.ele_crypto_CM7_CACHE
          config MCUX_DEPENDENCY_COMPONENT_component.ele_crypto_CM7_CACHE
              bool "MCUX_DEPENDENCY_COMPONENT_component.ele_crypto_CM7_CACHE"
              select MCUX_COMPONENT_driver.memory
              select MCUX_COMPONENT_driver.cache_armv7_m7
              depends on MCUX_HW_CORE_CM7F

          config MCUX_DEPENDENCY_COMPONENT_component.ele_crypto_CM33_XCACHE
              bool "MCUX_DEPENDENCY_COMPONENT_component.ele_crypto_CM33_XCACHE"
              select MCUX_COMPONENT_driver.cache_xcache
              depends on MCUX_HW_CORE_CM33

          config MCUX_DEPENDENCY_COMPONENT_component.ele_crypto_CM85_CACHE
              bool "MCUX_DEPENDENCY_COMPONENT_component.ele_crypto_CM85_CACHE"
              select MCUX_COMPONENT_driver.memory
              select MCUX_COMPONENT_driver.cache_armv7_m7
              depends on MCUX_HW_CORE_CM85

        endchoice
      endif

  config MCUX_COMPONENT_component.ele_nvm_manager
      bool "ele_nvm_manager"
      default y if MCUX_COMPONENT_component.ele_crypto
      depends on MCUX_COMPONENT_component.ele_crypto
      help
        NVM manager task for ELE key store persistence.  Required for both
        S400 and S100 variants when persistent keys (SYNC flag) are used.

endmenu
