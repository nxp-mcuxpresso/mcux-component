config MCUX_HAS_COMPONENT_driver.cmsis_mcx_enet
    bool
    default y if MCUX_HW_IP_DriverType_MCX_ENET

config MCUX_COMPONENT_driver.cmsis_mcx_enet
    bool "mcx_enet"
    select MCUX_COMPONENT_driver.mcx_enet
    select MCUX_COMPONENT_driver.cmsis_enet_phy
    select MCUX_COMPONENT_CMSIS_Driver_Include.Ethernet_MAC
    select MCUX_COMPONENT_CMSIS_Driver_Include.Ethernet
    select MCUX_COMPONENT_device.RTE
    depends on MCUX_HAS_COMPONENT_driver.cmsis_mcx_enet
