config MCUX_COMPONENT_component.gpio_adapter
    bool "gpio"
    default n
    help
        Enable component.gpio_adapter component

    select MCUX_COMPONENT_driver.gpio
    depends on MCUX_HAS_COMPONENT_driver.gpio
    if MCUX_COMPONENT_component.gpio_adapter
        choice
            prompt "MCUX_COMPONENT_component.gpio_adapter option 1"
            default MCUX_DEPENDENCY_COMPONENT_component.gpio_adapter_DEPEND_COMPONENT_OPTION_1 if !MCUX_HW_DEVICE_ID_MIMXRT798S && !MCUX_HW_DEVICE_ID_MIMXRT2660xxxxx && !MCUX_HW_DEVICE_ID_MIMXRT2661xxxxx && !MCUX_HW_DEVICE_ID_MIMXRT2662xxxxx && !MCUX_HW_DEVICE_ID_MIMXRT2663xxxxx
            default MCUX_DEPENDENCY_COMPONENT_component.gpio_adapter_DEPEND_COMPONENT_OPTION_2 if MCUX_HW_DEVICE_ID_MIMXRT798S || MCUX_HW_DEVICE_ID_MIMXRT2660xxxxx || MCUX_HW_DEVICE_ID_MIMXRT2661xxxxx || MCUX_HW_DEVICE_ID_MIMXRT2662xxxxx || MCUX_HW_DEVICE_ID_MIMXRT2663xxxxx
            config MCUX_DEPENDENCY_COMPONENT_component.gpio_adapter_DEPEND_COMPONENT_OPTION_1
                bool "Select driver.port"
                select MCUX_COMPONENT_driver.port
            config MCUX_DEPENDENCY_COMPONENT_component.gpio_adapter_DEPEND_COMPONENT_OPTION_2
                bool "Select MIMXRT798S or MIMXRT2660 family (no driver.port)"
                depends on MCUX_HW_DEVICE_ID_MIMXRT798S || MCUX_HW_DEVICE_ID_MIMXRT2660xxxxx || MCUX_HW_DEVICE_ID_MIMXRT2661xxxxx || MCUX_HW_DEVICE_ID_MIMXRT2662xxxxx || MCUX_HW_DEVICE_ID_MIMXRT2663xxxxx
        endchoice
    endif


config MCUX_COMPONENT_component.lpc_gpio_adapter
    bool "lpc_gpio"
    default n
    help
        Enable component.lpc_gpio_adapter component
    select MCUX_COMPONENT_driver.lpc_gpio
    select MCUX_COMPONENT_driver.inputmux
    select MCUX_COMPONENT_driver.pint
    depends on MCUX_HAS_COMPONENT_driver.lpc_gpio

